[0m09:44:06.609013 [debug] [Thread-1 (]: On model.day3_demo.sales_summary: /* {"app": "dbt", "dbt_version": "1.8.6", "profile_name": "my_snowflake_project", "target_name": "dev", "node_id": "model.day3_demo.sales_summary"} */
create or replace   view DAY3_DEMO.ANALYTICS.sales_summary
  
   as (
    

with f as (
  select * from DAY3_DEMO.ANALYTICS.fact_orders
),
c as (
  select * from DAY3_DEMO.ANALYTICS.dim_customers  -- current version only
),
p as (
  select * from DAY3_DEMO.ANALYTICS.dim_products
)
select
  c.country,
  p.category,
  date_trunc('day', f.order_date) as order_day,
  sum(f.total_amount)             as total_sales,
  count(distinct f.order_id)      as order_count
from f
left join c on f.customer_id = c.customer_id
left join p on f.product_id = p.product_id
group by c.country, p.category, date_trunc('day', f.order_date)
  );
