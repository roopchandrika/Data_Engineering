31Z", "completed_at": "2025-09-17T13:44:06.487576Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 3.0547471046447754, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01bf1cb8-0002-af1e-0003-2c6f0002808a"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.day3_demo.fact_orders", "compiled": true, "compiled_code": "\n\nwith o as (\n  select * from DAY3_DEMO.ANALYTICS.stg_orders\n),\np as (\n  select * from DAY3_DEMO.ANALYTICS.dim_products\n)\nselect\n  o.order_id,\n  o.order_date,\n  o.customer_id,\n  o.product_id,\n  o.quantity,\n  p.price,\n  (o.quantity * p.price) as total_amount\nfrom o\nleft join p on o.product_id = p.product_id", "relation_name": "DAY3_DEMO.ANALYTICS.fact_orders"}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-09-17T13:44:06.591170Z", "completed_at": "2025-09-17T13:44:06.598579Z"}, {"name": "execute", "started_at": "2025-09-17T13:44:06.599684Z", "completed_at": "2025-09-17T13:44:07.567789Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 1.0792326927185059, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01bf1cb8-0002-af1e-0003-2c6f0002808e"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.day3_demo.sales_summary", "compiled": true, "compiled_code": "\n\nwith f as (\n  select * from DAY3_DEMO.ANALYTICS.fact_orders\n),\nc as (\n  select * from DAY3_DEMO.ANALYTICS.dim_customers  -- current version only\n),\np as (\n  select * from DAY3_DEMO.ANALYTICS.dim_products\n)\nselect\n  c.country,\n  p.category,\n  date_trunc('day', f.order_date) as order_day,\n  sum(f.total_amount)             as total_sales,\n  count(distinct f.order_id)      as order_count\nfrom f\nleft join c on f.customer_id = c.customer_id\nleft join p on f.product_id = p.product_id\ngroup by c.country, p.category, date_trunc('day', f.order_date)", "relation_name": "DAY3_DEMO.ANALYTICS.sales_summary"}], "elapsed_time